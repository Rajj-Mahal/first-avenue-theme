<section class="section">
  <div class="container">
    <h1 class="page-header__title" style="text-align:center;margin-bottom:2rem;">{{ 'customer.login.title' | t }}</h1>
    <div class="customer-form">
      {%- form 'customer_login' -%}
        {{ form.errors | default_errors }}
        <div class="form-group">
          <label for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
          <input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email">
        </div>
        <div class="form-group">
          <label for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
          <input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password">
        </div>
        <button type="submit" class="btn btn--dark btn--full">{{ 'customer.login.submit' | t }}</button>
        <p style="text-align:center;margin-top:1rem;">
          <a href="{{ routes.root_url }}account/forgot_password">{{ 'customer.login.forgot_password' | t }}</a>
        </p>
      {%- endform -%}
      <p style="text-align:center;margin-top:1.5rem;">
        <a href="{{ routes.account_register_url }}">{{ 'customer.register.title' | t }}</a>
      </p>
    </div>
  </div>
</section>
