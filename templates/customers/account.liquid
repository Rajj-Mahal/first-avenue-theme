<section class="section">
  <div class="container">
    <h1 class="page-header__title">{{ 'customer.account.title' | t }}</h1>
    <p style="margin:0.5rem 0 2rem;">{{ customer.name }} &mdash; <a href="{{ routes.account_logout_url }}">Log out</a></p>

    <h2 style="margin-bottom:1rem;">{{ 'customer.account.orders' | t }}</h2>
    {%- if customer.orders.size > 0 -%}
      <table class="cart-table">
        <thead>
          <tr>
            <th>Order</th>
            <th>Date</th>
            <th>Status</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr>
              <td><a href="{{ order.customer_url }}">{{ 'customer.account.order_id' | t: name: order.name }}</a></td>
              <td>{{ order.created_at | date: '%B %d, %Y' }}</td>
              <td>{{ order.financial_status_label }}</td>
              <td>{{ order.total_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- else -%}
      <p>You haven&rsquo;t placed any orders yet.</p>
    {%- endif -%}
  </div>
</section>
