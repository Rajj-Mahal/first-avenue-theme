<section class="section">
  <div class="container">
    <h1 class="page-header__title">Your Addresses</h1>
    <p style="margin-bottom:2rem;"><a href="{{ routes.account_url }}">&larr; Back to account</a></p>

    {%- for address in customer.addresses -%}
      <div style="border:1px solid #eee;padding:1.25rem;border-radius:4px;margin-bottom:1.5rem;max-width:400px;">
        {{ address | format_address }}
        {%- if address == customer.default_address -%}
          <p style="margin-top:0.5rem;font-size:0.85rem;color:#888;">Default address</p>
        {%- endif -%}
      </div>
    {%- else -%}
      <p>No addresses saved.</p>
    {%- endfor -%}
  </div>
</section>
