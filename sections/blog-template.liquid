<section class="section">
  <div class="container">
    <h1 class="page-header__title">{{ blog.title }}</h1>

    <div class="article-list" style="margin-top:2rem;">
      {%- for article in blog.articles -%}
        <div class="article-card">
          {%- if article.image -%}
            <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.image.alt | escape }}" width="600">
          {%- endif -%}
          <div class="article-card__body">
            <p class="article-card__date">{{ article.published_at | date: '%B %d, %Y' }}</p>
            <h2 class="article-card__title">
              <a href="{{ article.url }}">{{ article.title }}</a>
            </h2>
            <p>{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
            <a href="{{ article.url }}" style="display:inline-block;margin-top:0.75rem;">Read more &rarr;</a>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <div style="text-align:center;margin-top:2rem;">{{ paginate | default_pagination }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog posts"
}
{% endschema %}
