<section class="about-page">
  <!-- Page hero -->
  <div class="about-page__hero">
    <div class="container">
      {%- if section.settings.eyebrow != blank -%}
        <p class="about-page__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="about-page__title">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="about-page__subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  </div>

  <!-- Editable blocks -->
  {%- for block in section.blocks -%}
    {%- case block.type -%}

      {%- when 'text' -%}
        <div class="about-block about-block--text" {{ block.shopify_attributes }}>
          <div class="container">
            {%- if block.settings.eyebrow != blank -%}
              <p class="about-block__eyebrow">{{ block.settings.eyebrow }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="about-block__heading">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="about-block__body rte">{{ block.settings.body }}</div>
            {%- endif -%}
          </div>
        </div>

      {%- when 'image_text' -%}
        <div class="about-block about-block--image-text{% if block.settings.image_position == 'right' %} is-reversed{% endif %}" {{ block.shopify_attributes }}>
          <div class="container">
            <div class="about-block__inner">
              <div class="about-block__image">
                {%- if block.settings.image -%}
                  <img src="{{ block.settings.image | image_url: width: 900 }}"
                       alt="{{ block.settings.image.alt | escape }}"
                       width="900" loading="lazy">
                {%- else -%}
                  <img src="https://picsum.photos/seed/about{{ forloop.index }}/900/675"
                       alt="About image" width="900" height="675" loading="lazy">
                {%- endif -%}
              </div>
              <div class="about-block__content">
                {%- if block.settings.eyebrow != blank -%}
                  <p class="about-block__eyebrow">{{ block.settings.eyebrow }}</p>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="about-block__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <div class="about-block__body rte">{{ block.settings.body }}</div>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <div style="margin-top:1.75rem;">
                    <a href="{{ block.settings.button_url | default: '#' }}" class="btn btn--outline">
                      {{ block.settings.button_label }}
                    </a>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>

      {%- when 'values' -%}
        <div class="about-block about-block--values" {{ block.shopify_attributes }}>
          <div class="container">
            {%- if block.settings.heading != blank -%}
              <h2 class="about-block__heading" style="text-align:center;">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.subheading != blank -%}
              <p class="about-block__body" style="text-align:center;max-width:600px;margin:0.75rem auto 0;">{{ block.settings.subheading }}</p>
            {%- endif -%}
            <div class="about-values-grid">
              {%- for i in (1..3) -%}
                {%- assign title_key = 'value_' | append: i | append: '_title' -%}
                {%- assign text_key = 'value_' | append: i | append: '_text' -%}
                {%- if block.settings[title_key] != blank -%}
                  <div class="about-value-card">
                    <p class="about-value-card__title">{{ block.settings[title_key] }}</p>
                    {%- if block.settings[text_key] != blank -%}
                      <p class="about-value-card__text">{{ block.settings[text_key] }}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>

    {%- endcase -%}
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "About page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Page heading",
      "default": "Crafted to reflect"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We make mirrors and frames the slow way — solid materials, traditional joinery, finished by hand."
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text block",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body text"
        }
      ]
    },
    {
      "type": "image_text",
      "name": "Image + Text",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        }
      ]
    },
    {
      "type": "values",
      "name": "Values / Mission",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Section heading",
          "default": "What We Stand For"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Section subheading"
        },
        {
          "type": "text",
          "id": "value_1_title",
          "label": "Value 1 title",
          "default": "Solid Materials"
        },
        {
          "type": "textarea",
          "id": "value_1_text",
          "label": "Value 1 description",
          "default": "Solid wood, true glass, and brass hardware — never veneer or plastic shortcuts."
        },
        {
          "type": "text",
          "id": "value_2_title",
          "label": "Value 2 title",
          "default": "Timeless Design"
        },
        {
          "type": "textarea",
          "id": "value_2_text",
          "label": "Value 2 description",
          "default": "We design for rooms, not trends — pieces that still feel right in a decade."
        },
        {
          "type": "text",
          "id": "value_3_title",
          "label": "Value 3 title",
          "default": "Made to Order"
        },
        {
          "type": "textarea",
          "id": "value_3_text",
          "label": "Value 3 description",
          "default": "Each mirror and frame is built after you order it, in small batches."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About page",
      "blocks": [
        {
          "type": "image_text",
          "settings": {
            "image_position": "left",
            "eyebrow": "Who We Are",
            "heading": "Started in a small workshop.",
            "body": "<p>We began building mirrors and frames because we couldn't find pieces made to last. Every order is still cut, joined, and finished by hand.</p>"
          }
        },
        {
          "type": "values"
        }
      ]
    }
  ]
}
{% endschema %}
