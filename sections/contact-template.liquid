<section class="contact-page section">
  <div class="container">
    <div class="contact-page__inner">

      <!-- Left: heading, intro, info blocks -->
      <div class="contact-page__left">
        {%- if section.settings.heading != blank -%}
          <h1 class="contact-page__heading">{{ section.settings.heading }}</h1>
        {%- endif -%}

        {%- if section.settings.intro != blank -%}
          <p class="contact-page__intro">{{ section.settings.intro }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="contact-info-list">
            {%- for block in section.blocks -%}
              <li class="contact-info-item" {{ block.shopify_attributes }}>
                <div class="contact-info-icon">
                  {%- case block.settings.icon -%}
                    {%- when 'location' -%}
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    {%- when 'email' -%}
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    {%- when 'phone' -%}
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.38 2 2 0 0 1 3.58 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.5a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.72 16z"/></svg>
                    {%- when 'clock' -%}
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    {%- else -%}
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                  {%- endcase -%}
                </div>
                <div>
                  {%- if block.settings.label != blank -%}
                    <p class="contact-info-label">{{ block.settings.label }}</p>
                  {%- endif -%}
                  {%- if block.settings.value != blank -%}
                    <p class="contact-info-value">{{ block.settings.value | newline_to_br }}</p>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <!-- Right: inquiry form -->
      <div class="contact-page__right">
        <div class="contact-form-panel">
          {%- if section.settings.form_heading != blank -%}
            <h2 class="contact-form-title">{{ section.settings.form_heading }}</h2>
          {%- endif -%}

          {%- if section.settings.form_endpoint != blank -%}
            <!-- Formspree-powered form: sends to the email configured on formspree.io -->
            <form
              class="contact-form"
              id="contact-inquiry-form"
              action="{{ section.settings.form_endpoint }}"
              method="POST"
              novalidate>

              <!-- Formspree control fields -->
              <input type="hidden" name="_subject" value="{{ section.settings.email_subject | default: 'New inquiry from your website' }}">
              <input type="hidden" name="_next" value="{{ section.settings.success_redirect | default: page.url }}">
              <!-- Anti-bot honeypot -->
              <div style="position:absolute;left:-5000px;" aria-hidden="true">
                <input type="text" name="_gotcha" tabindex="-1" value="">
              </div>

              <div class="contact-form__row">
                <div class="contact-form__group">
                  <label class="contact-form__label" for="cf-fname">First Name <span aria-hidden="true">*</span></label>
                  <input class="contact-form__input" type="text" id="cf-fname" name="first_name" autocomplete="given-name" required>
                </div>
                <div class="contact-form__group">
                  <label class="contact-form__label" for="cf-lname">Last Name</label>
                  <input class="contact-form__input" type="text" id="cf-lname" name="last_name" autocomplete="family-name">
                </div>
              </div>

              <div class="contact-form__group">
                <label class="contact-form__label" for="cf-email">Email <span aria-hidden="true">*</span></label>
                <input class="contact-form__input" type="email" id="cf-email" name="email" autocomplete="email" required>
              </div>

              {%- if section.settings.show_phone -%}
                <div class="contact-form__group">
                  <label class="contact-form__label" for="cf-phone">Phone</label>
                  <input class="contact-form__input" type="tel" id="cf-phone" name="phone" autocomplete="tel">
                </div>
              {%- endif -%}

              {%- if section.settings.show_subject -%}
                <div class="contact-form__group">
                  <label class="contact-form__label" for="cf-subject">Subject</label>
                  <input class="contact-form__input" type="text" id="cf-subject" name="subject">
                </div>
              {%- endif -%}

              <div class="contact-form__group">
                <label class="contact-form__label" for="cf-message">Message <span aria-hidden="true">*</span></label>
                <textarea class="contact-form__textarea" id="cf-message" name="message" rows="5" required></textarea>
              </div>

              <button type="submit" class="btn btn--dark btn--full">{{ section.settings.submit_label }}</button>

              <p class="contact-form__sent" id="cf-success-msg" style="display:none;">
                {{ section.settings.success_message | default: "Thanks for reaching out — we'll be in touch soon!" }}
              </p>
            </form>

            <script>
              (function () {
                var form = document.getElementById('contact-inquiry-form');
                if (!form) return;
                form.addEventListener('submit', function (e) {
                  e.preventDefault();
                  var data = new FormData(form);
                  fetch(form.action, {
                    method: 'POST',
                    body: data,
                    headers: { 'Accept': 'application/json' }
                  }).then(function (res) {
                    if (res.ok) {
                      form.reset();
                      form.style.display = 'none';
                      document.getElementById('cf-success-msg').style.display = 'block';
                    } else {
                      alert('Something went wrong. Please try again or email us directly.');
                    }
                  }).catch(function () {
                    alert('Something went wrong. Please check your connection and try again.');
                  });
                });
              })();
            </script>

          {%- else -%}
            <!-- Shopify native contact form (sends to store notification email in Admin → Settings → General) -->
            {%- form 'contact' -%}
              {%- if form.posted_successfully? -%}
                <p class="contact-form__success">{{ section.settings.success_message | default: "Thanks for reaching out — we'll be in touch soon!" }}</p>
              {%- else -%}
                {%- if form.errors -%}
                  <p class="contact-form__error">{{ form.errors | default_errors }}</p>
                {%- endif -%}
                <div class="contact-form">
                  <div class="contact-form__row">
                    <div class="contact-form__group">
                      <label class="contact-form__label" for="cf-name">Name <span aria-hidden="true">*</span></label>
                      <input class="contact-form__input" type="text" id="cf-name" name="contact[name]" autocomplete="name" required>
                    </div>
                    <div class="contact-form__group">
                      <label class="contact-form__label" for="cf-email-native">Email <span aria-hidden="true">*</span></label>
                      <input class="contact-form__input" type="email" id="cf-email-native" name="contact[email]" autocomplete="email" required>
                    </div>
                  </div>
                  {%- if section.settings.show_phone -%}
                    <div class="contact-form__group">
                      <label class="contact-form__label" for="cf-phone-native">Phone</label>
                      <input class="contact-form__input" type="tel" id="cf-phone-native" name="contact[phone]" autocomplete="tel">
                    </div>
                  {%- endif -%}
                  {%- if section.settings.show_subject -%}
                    <div class="contact-form__group">
                      <label class="contact-form__label" for="cf-subject-native">Subject</label>
                      <input class="contact-form__input" type="text" id="cf-subject-native" name="contact[subject]">
                    </div>
                  {%- endif -%}
                  <div class="contact-form__group">
                    <label class="contact-form__label" for="cf-message-native">Message <span aria-hidden="true">*</span></label>
                    <textarea class="contact-form__textarea" id="cf-message-native" name="contact[body]" rows="5" required></textarea>
                  </div>
                  <button type="submit" class="btn btn--dark btn--full">{{ section.settings.submit_label }}</button>
                </div>
              {%- endif -%}
            {%- endform -%}
          {%- endif -%}

        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in Touch"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "Have a question or want to work together? We'd love to hear from you."
    },
    {
      "type": "header",
      "content": "Inquiry Form"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Send an Inquiry"
    },
    {
      "type": "text",
      "id": "form_endpoint",
      "label": "Recipient form endpoint URL",
      "info": "To send inquiries to a specific email: (1) Create a free account at formspree.io, (2) create a new form and enter your desired recipient email, (3) copy the endpoint URL (e.g. https://formspree.io/f/xxxxxxxx) and paste it here. Leave blank to use Shopify's built-in contact form, which delivers to your store notification email (Admin → Settings → General)."
    },
    {
      "type": "text",
      "id": "email_subject",
      "label": "Email subject line",
      "default": "New inquiry from your website",
      "info": "The subject line used when Formspree delivers the email to your inbox."
    },
    {
      "type": "header",
      "content": "Form Fields"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone number field",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_subject",
      "label": "Show subject field",
      "default": false
    },
    {
      "type": "header",
      "content": "After Submission"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for reaching out — we'll be in touch soon!"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button label",
      "default": "Send Message"
    }
  ],
  "blocks": [
    {
      "type": "info",
      "name": "Contact info item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "location", "label": "Location / Address" },
            { "value": "email", "label": "Email" },
            { "value": "phone", "label": "Phone" },
            { "value": "clock", "label": "Hours" }
          ],
          "default": "location"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Address"
        },
        {
          "type": "textarea",
          "id": "value",
          "label": "Value",
          "default": "123 Main Street\nNew York, NY 10001"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact page",
      "blocks": [
        {
          "type": "info",
          "settings": {
            "icon": "email",
            "label": "Email Us",
            "value": "hello@yourstore.com"
          }
        },
        {
          "type": "info",
          "settings": {
            "icon": "phone",
            "label": "Call Us",
            "value": "(555) 000-0000"
          }
        },
        {
          "type": "info",
          "settings": {
            "icon": "clock",
            "label": "Hours",
            "value": "Mon – Fri: 9am – 5pm\nSat – Sun: Closed"
          }
        }
      ]
    }
  ]
}
{% endschema %}
