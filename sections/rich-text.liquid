<section class="section rich-text">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="rich-text__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="rich-text__body rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
      <div style="margin-top:1.5rem;">
        <a href="{{ section.settings.button_url }}" class="btn btn--dark">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed to be lived with"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Each piece is made to order using solid materials and traditional joinery — built for daily use, not just a season.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
