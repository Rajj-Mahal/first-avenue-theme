<section class="section">
  <div class="container">
    <h1 class="page-header__title">{{ 'general.search.search' | t }}</h1>

    {%- form 'search', class: 'search-form' -%}
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.search' | t }}">
      <button type="submit" class="btn btn--dark">{{ 'general.search.search' | t }}</button>
    {%- endform -%}

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p style="margin-bottom:1.5rem;">{{ search.results_count }} result(s) for &ldquo;{{ search.terms }}&rdquo;</p>
        <div class="product-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'card-product', product: item %}
            {%- else -%}
              <div class="card-product">
                <div class="card-product__info">
                  <p class="card-product__title"><a href="{{ item.url }}">{{ item.title }}</a></p>
                  <p>{{ item.content | strip_html | truncate: 100 }}</p>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p>No results for &ldquo;{{ search.terms }}&rdquo;.</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search"
}
{% endschema %}
