<section class="section">
  <div class="container">
    <h1 class="page-header__title">{{ 'cart.general.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      {%- form 'cart', cart -%}
        <table class="cart-table">
          <thead>
            <tr>
              <th>Product</th>
              <th>Price</th>
              <th>Quantity</th>
              <th>Total</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td>
                  <div class="cart-item__product">
                    {%- if item.image -%}
                      <a href="{{ item.url }}" class="cart-item__img-link">
                        <img src="{{ item.image | image_url: width: 100 }}"
                             alt="{{ item.image.alt | escape }}"
                             width="80" height="80"
                             class="cart-item__img">
                      </a>
                    {%- endif -%}
                    <div class="cart-item__details">
                      <a href="{{ item.url }}" class="cart-item__name">{{ item.product.title }}</a>
                      {%- unless item.product.has_only_default_variant -%}
                        <span class="cart-item__variant">{{ item.variant.title }}</span>
                      {%- endunless -%}
                    </div>
                  </div>
                </td>
                <td>{{ item.price | money }}</td>
                <td>
                  <input class="cart-quantity" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
                </td>
                <td>{{ item.line_price | money }}</td>
                <td>
                  <a href="{{ item.url_to_remove }}" class="cart-item__remove">{{ 'cart.general.remove' | t }}</a>
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <div class="cart-totals">
          <p class="cart-totals__subtotal">Subtotal: {{ cart.total_price | money }}</p>
          <button type="submit" name="checkout" class="btn btn--dark">{{ 'cart.general.checkout' | t }}</button>
        </div>
      {%- endform -%}
    {%- else -%}
      <p>{{ 'cart.general.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline" style="margin-top:1rem;">
        {{ 'cart.general.continue_shopping' | t }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart"
}
{% endschema %}
